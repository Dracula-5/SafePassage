# One address: the web app, with the API behind it. With an https:// PUBLIC_URL, Caddy gets and renews the certificate by
# itself. It replaces any X-Forwarded-For a client sends, so the rate limiter sees real addresses, and it
# streams /api/stream unbuffered without being told. Keep this free of `encode`: compression would hold
# back the stream.
{$PUBLIC_URL} {
	request_body {
		max_size 2MB
	}
	@backend path /api/* /health /portal/api/* /portal/whatsapp
	handle @backend {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}
