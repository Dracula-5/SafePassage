# infra/deploy/setup.sh fills this in with strong secrets and writes infra/deploy/.env. Never commit that.
# By hand, make every secret with: openssl rand -hex 32   (hex, because these go inside connection URLs)
# The API refuses to start if a required one is missing or too short.

# The address people will use, with https://. Its DNS must point at this VM: Caddy gets the certificate for it.
PUBLIC_URL=
DATA_DIR=/srv/reliefroute-data

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
# Not typed at sign-up. It approves the first duty officer (X-Operator-Token) and works for scripts and the runbook.
# After that, approved duty officers approve other duty officers and drivers in the Team tab.
OPERATOR_TOKEN=
# Only for the legacy POST /api/vehicles endpoint (X-Enrolment-Code). Web sign-up asks for no code.
ENROLMENT_CODE=

LOG_LEVEL=INFO
# Leave empty: the web app and the API share one address.
CORS_ORIGINS=[]
REGION_BBOX=76.6,12.5,84.9,20.1
REGION_NAME=Andhra Pradesh

LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Optional email: confirms addresses and lets people reset their own passwords. Any provider's SMTP works.
# Until SMTP_HOST and MAIL_FROM are set, a duty officer makes reset links in the Team tab.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional: each stays off until set.
FIRMS_MAP_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Drills stay silent unless this is true. Leave it off: a real supplier cannot tell a drill from an order in time.
DRILL_SEND_MESSAGES=false
# Clear plans go out by themselves, and anything unclear waits for a person (agents/approval.py). False: a person decides every plan.
AUTO_APPROVE=true
# When a plan's trucks finish, what is still needed goes out by itself, this many times per alert. 0 turns it off.
NEXT_WAVE_MAX=10
# For a presentation only: 42 simulated trucks and water depots, marked as simulated everywhere. Also start
# compose with --profile demo. To go live for real, follow "Ending presentation mode" in docs/demo-script.md.
DEMO_FLEET=false
