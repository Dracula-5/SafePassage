# Copy to infra/deploy/.env and fill in. Never commit the copy.
# Make every secret with: openssl rand -hex 32   (hex, because these go inside connection URLs)
# The API refuses to start if a required one is missing or too short.

# The name that points at this VM. Caddy gets the HTTPS certificate for it.
DOMAIN=
DATA_DIR=/srv/reliefroute-data

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
# Without this anyone could publish drills, approve plans and read driver positions.
OPERATOR_TOKEN=
# Drivers type this once to register. Without it a stranger's phone could join the fleet.
ENROLMENT_CODE=

LOG_LEVEL=INFO
# The dashboard's address, e.g. ["https://reliefroute.vercel.app"]
CORS_ORIGINS=[]
REGION_BBOX=76.6,12.5,84.9,20.1
REGION_NAME=Andhra Pradesh

LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Optional: each stays off until set.
FIRMS_MAP_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Drills stay silent unless this is true. Leave it off: a real supplier cannot tell a drill from an order in time.
DRILL_SEND_MESSAGES=false
