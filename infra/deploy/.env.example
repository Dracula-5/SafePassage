# Copy to infra/deploy/.env and fill in. Never commit the copy.
DATA_DIR=/srv/reliefroute-data
POSTGRES_PASSWORD=
# Required: without it anyone can publish drills and approve plans.
OPERATOR_TOKEN=

APP_ENV=production
LOG_LEVEL=INFO
# The dashboard's address, e.g. ["https://reliefroute.vercel.app"]
CORS_ORIGINS=[]
REGION_BBOX=76.6,12.5,84.9,20.1
REGION_NAME=Andhra Pradesh

LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Optional: each stays off until set.
FIRMS_MAP_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
