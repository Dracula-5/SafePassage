# Copy to .env.local. Next forwards API calls here, so the site and API share one address.
# On Vercel set the same variable in the project settings to the backend's https origin (no trailing slash), then
# redeploy: it is read at build time, and a Vercel build without it stops. See docs/deploy-vercel-render.md.
API_ORIGIN=http://127.0.0.1:8000
# Initial map view (min_lon,min_lat,max_lon,max_lat); matches REGION_BBOX of the backend
NEXT_PUBLIC_REGION_BBOX=76.6,12.5,84.9,20.1
