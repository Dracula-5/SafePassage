# Copy to backend/.env and fill in real values. backend/.env is git-ignored: never commit keys.
# Common keys are shared with env/senses.env.example.
APP_ENV=development
DATABASE_URL=postgresql://reliefroute:reliefroute@localhost:5432/reliefroute
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM (provider-agnostic client in app/llm/)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model id is chosen and verified against the live API in Gate 2.
LLM_MODEL=

# --- Routing
VALHALLA_URL=http://localhost:8002

# --- Optional: each stays off until its keys are set
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Required on any public deployment: drills, plan triggers and approvals need this token.
# OPERATOR_TOKEN=
