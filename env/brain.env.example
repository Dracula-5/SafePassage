# Copy to backend/.env and fill in real values. backend/.env is git-ignored: never commit keys.
# Common keys are shared with env/senses.env.example.
APP_ENV=development
DATABASE_URL=postgresql://reliefroute:reliefroute@localhost:5432/reliefroute
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM (provider-agnostic client in app/llm/)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model id is chosen and verified against the live API in Gate 2.
LLM_MODEL=

# --- Routing
VALHALLA_URL=http://localhost:8002

# Later gates add: LANGFUSE_*, TWILIO_* (with the components that use them).
