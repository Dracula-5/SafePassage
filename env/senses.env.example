# Copy to backend/.env (git-ignored). Common keys match env/brain.env.example.
APP_ENV=development
DATABASE_URL=postgresql://reliefroute:reliefroute@localhost:55432/reliefroute
REDIS_URL=redis://localhost:6380/0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Demo region (Andhra Pradesh with a small margin): min_lon,min_lat,max_lon,max_lat
REGION_BBOX=76.6,12.5,84.9,20.1
REGION_NAME=Andhra Pradesh

# Optional live sources: each is disabled (not faked) until its key is set.
FIRMS_MAP_KEY=
# DATAGOV_API_KEY=   (data.gov.in FCI godowns; not wired yet, see docs/gates/B-G1.md)

# Facilities fallback built by infra/osm/extract_facilities.sh
# FACILITIES_EXTRACT_PATH=/Users/<you>/reliefroute-data/osm/facilities.geojsonseq
